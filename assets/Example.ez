# ============================================================================
# Example.ez — Comprehensive EZ Language Frontend Showcase
#
# This file exercises every AST node type recognised by the EzLexer parser:
#
#   Module, ModuleHeader, CodeScope, Variable, Instruction, CallInstruction,
#   ImmediateOperand (Integer, Float, String), MemoryOperand (BaseDisplacement,
#   BaseIndexScaleDisplacement, IndexScale, Direct), Label, IfAstNode,
#   ConditionAstNode (all 6 comparison operators), WhileAstNode, ForAstNode,
#   SwitchAstNode, SwitchCaseAstNode, BreakAstNode, ContinueAstNode,
#   IncludeAstNode
# ============================================================================

# ── Include directive (IncludeAstNode) ────────────────────────────────────────
# include <"helpers.ez">

i32 %myGlobalVar: {3, 4, 5, 6, 7}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Module 1 — Helper function with parameters and a return value             ║
# ║  AST nodes:  Module, ModuleHeader (with parameters), Variable,             ║
# ║              Instruction, ImmediateOperand (Integer)                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
i64 addValues(i64 %a, i64 %b)
{
    # Variable declaration (Variable node with typed declaration via 'create')
    create i64 %result;

    # Instructions with variable operands
    mov %result, %a;
    add %result, %b;
    xor %myGlobalVar, 1;

    # Return instruction
    ret %result;
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Module 2 — Void function, no parameters                                  ║
# ║  AST nodes:  Module (void return), ModuleHeader (no params)                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
void doNothing()
{
    nop;
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Module 3 — Main entry point: demonstrates every remaining AST node       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
void main()
{
    # ── 1. Variable declarations ─────────────────────────────────────────────
    # Plain typed variables (Variable with data type, no initializer)
    create i64 %counter;
    create i64 %limit;
    create i32 %selector;
    create i8  %byteVal;
    create i64 %addr;
    create i64 %temp;
    create i64 %index;

    create i64 %initVal;

    # Variable with multi-element brace initializer (array)
    create i8 %lookupTable: {0x10, 0x20, 0x30, 0x40};

    # ── 2. Immediate operands ────────────────────────────────────────────────
    # IntegerImmediate — decimal
    mov %counter, 0;
    mov %limit, 100;

    # IntegerImmediate — hexadecimal
    mov %addr, 0xDEAD0000;

    # IntegerImmediate — typed cast (i16 prefix)
    mov %byteVal, i8 255;

    # FloatImmediate
    create double %doubleVar;
    mov %doubleVar, 3.14;

    # StringImmediate
    create string %stringVar;
    mov %stringVar, "Hello, EZ!";

    # ── 3. Instruction varieties ─────────────────────────────────────────────
    # Zero-operand instruction
    nop;

    # Two-operand arithmetic instructions
    add %counter, 1;
    sub %counter, 1;
    mul %counter, 2;
    div %counter, 2;

    # Bitwise instructions
    xor %counter, 0xFF;
    and %counter, 0x0F;
    or  %counter, 0xF0;

    # Comparison instruction
    cmp %counter, %limit;

    # Jump instructions
    jmp %label_entry;
    jge %label_entry;
    jle %label_entry;

    # ── 4. Memory operands (all 4 addressing modes) ──────────────────────────
    # BaseDisplacement — positive offset: type (%base+displacement)
    load %temp, i64 (%addr+0x10);

    # BaseDisplacement — negative offset
    load %temp, i64 (%addr-8);

    # BaseDisplacement — zero offset
    store i8 (%addr+0), %byteVal;

    # BaseIndexScaleDisplacement: type (%base, %index, scale, displacement)
    load %temp, i64 (%addr, %index, 8, 0);

    # IndexScale: type (, %index, scale)
    load %temp, i64 (, %index, 4);

    # Direct: type (address)
    load %temp, i32 (0xDEADBEEF);

    # ── 5. Labels (Label + CodeScope) ────────────────────────────────────────
    label_entry:
    {
        mov %counter, 0;
        nop;
    }

    label_work:
    {
        add %counter, 1;
    }

    # ── 6. Call instruction (CallInstruction) ────────────────────────────────
    # Call with no arguments
    call %doNothing();

    # Call with arguments
    call %addValues(%counter, %limit);

    # ── 7. If / else if / else (IfAstNode, ConditionAstNode) ────────────────
    # All six comparison operators:  EQ  NE  GT  GE  LT  LE

    # Simple if — Equal
    if (%counter EQ 0)
    {
        mov %counter, 1;
    }

    # If / else — Not-Equal
    if (%counter NE %limit)
    {
        add %counter, 1;
    }
    else
    {
        mov %counter, 0;
    }

    # If / else-if / else — Greater-Than, Less-Than
    if (%counter GT 50)
    {
        sub %counter, 10;
    }
    else if (%counter LT 10)
    {
        add %counter, 10;
    }
    else
    {
        nop;
    }

    # Greater-Than-Or-Equal and Less-Than-Or-Equal
    if (%counter GE %limit)
    {
        mov %counter, 0;
    }

    if (%counter LE 0)
    {
        mov %counter, 1;
    }

    # ── 8. While loop (WhileAstNode) with break and continue ────────────────
    mov %counter, 0;
    while (%counter LT %limit)
    {
        add %counter, 1;

        # BreakAstNode — exit the loop early
        if (%counter EQ 50)
        {
            break;
        }

        # ContinueAstNode — skip to next iteration
        if (%counter EQ 25)
        {
            continue;
        }

        nop;
    }

    # ── 9. For loop (ForAstNode) ─────────────────────────────────────────────
    # for ({init} (condition) {next-iteration}) { body }
    for ({create i64 %i; mov %i, 0;} (%i LT 10) {add %i, 1;})
    {
        add %counter, %i;
    }

    # ── 10. Switch / case / default (SwitchAstNode, SwitchCaseAstNode) ───────
    mov %selector, 2;
    switch (%selector)
    {
        case 1:
        {
            mov %temp, 100;
            break;
        }
        case 2:
        {
            mov %temp, 200;
            break;
        }
        case 3:
        {
            mov %temp, 300;
        }
        default:
        {
            mov %temp, 0;
        }
    }

    # ── 11. Nested control flow ──────────────────────────────────────────────
    # While containing an if containing a for
    mov %counter, 0;
    while (%counter LT 5)
    {
        if (%counter EQ 3)
        {
            for ({create i64 %j; mov %j, 0;} (%j LT 2) {add %j, 1;})
            {
                nop;
            }
        }
        add %counter, 1;
    }

    # Final return
    ret %counter;
}

