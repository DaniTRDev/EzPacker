# Pure-CMake generator for musl headers (bits/alltypes.h, bits/syscall.h, version.h)
# and staging of the unified public musl include tree without requiring sed/sh/awk.

function(ezmusl_transform_alltypes_line LINE OUT_VAR)
    if (LINE MATCHES "^TYPEDEF (.*) ([^ ]+)__EZ_SEMI__$")
        set(_type "${CMAKE_MATCH_1}")
        set(_name "${CMAKE_MATCH_2}")
        set(${OUT_VAR}
"#if defined(__NEED_${_name}) && !defined(__DEFINED_${_name})
typedef ${_type} ${_name}__EZ_SEMI__
#define __DEFINED_${_name}
#endif"
            PARENT_SCOPE)
    elseif (LINE MATCHES "^STRUCT \\* ([^ ]+) (.*)__EZ_SEMI__$")
        set(_name "${CMAKE_MATCH_1}")
        set(_rest "${CMAKE_MATCH_2}")
        set(${OUT_VAR}
"#if defined(__NEED_struct_${_name}) && !defined(__DEFINED_struct_${_name})
struct ${_name} ${_rest}__EZ_SEMI__
#define __DEFINED_struct_${_name}
#endif"
            PARENT_SCOPE)
    elseif (LINE MATCHES "^STRUCT ([^ ]+) (.*)__EZ_SEMI__$")
        set(_name "${CMAKE_MATCH_1}")
        set(_rest "${CMAKE_MATCH_2}")
        set(${OUT_VAR}
"#if defined(__NEED_struct_${_name}) && !defined(__DEFINED_struct_${_name})
struct ${_name} ${_rest}__EZ_SEMI__
#define __DEFINED_struct_${_name}
#endif"
            PARENT_SCOPE)
    elseif (LINE MATCHES "^UNION \\* ([^ ]+) (.*)__EZ_SEMI__$")
        set(_name "${CMAKE_MATCH_1}")
        set(_rest "${CMAKE_MATCH_2}")
        set(${OUT_VAR}
"#if defined(__NEED_union_${_name}) && !defined(__DEFINED_union_${_name})
union ${_name} ${_rest}__EZ_SEMI__
#define __DEFINED_union_${_name}
#endif"
            PARENT_SCOPE)
    elseif (LINE MATCHES "^UNION ([^ ]+) (.*)__EZ_SEMI__$")
        set(_name "${CMAKE_MATCH_1}")
        set(_rest "${CMAKE_MATCH_2}")
        set(${OUT_VAR}
"#if defined(__NEED_union_${_name}) && !defined(__DEFINED_union_${_name})
union ${_name} ${_rest}__EZ_SEMI__
#define __DEFINED_union_${_name}
#endif"
            PARENT_SCOPE)
    elseif (LINE MATCHES "^#define __LONG_MAX (.+)$")
        set(${OUT_VAR}
"#ifndef __LONG_MAX
#if defined(_WIN32) && !defined(__LP64__)
#define __LONG_MAX 0x7fffffffL
#else
#define __LONG_MAX ${CMAKE_MATCH_1}
#endif
#endif"
            PARENT_SCOPE)
    else ()
        set(${OUT_VAR} "${LINE}" PARENT_SCOPE)
    endif ()
endfunction()

function(ezmusl_read_lines_preserving_semicolons FILE_PATH OUT_VAR)
    file(READ "${FILE_PATH}" _raw)
    string(REPLACE "\r\n" "\n" _raw "${_raw}")
    string(REPLACE ";" "__EZ_SEMI__" _raw "${_raw}")
    string(REPLACE "\n" ";" _lines "${_raw}")
    set(${OUT_VAR} "${_lines}" PARENT_SCOPE)
endfunction()

function(ezmusl_generate_alltypes ARCH_IN GENERIC_IN OUT_FILE)
    ezmusl_read_lines_preserving_semicolons("${ARCH_IN}" _arch_lines)
    ezmusl_read_lines_preserving_semicolons("${GENERIC_IN}" _gen_lines)

    set(_out_chunks
"/* Generated by EzMusl/cmake/GenerateMuslHeaders.cmake */
#ifdef __chibicc__
#ifndef __EZPACKER_CHIBICC_VA_LIST_DEFINED
#define __EZPACKER_CHIBICC_VA_LIST_DEFINED
typedef struct {
    unsigned int gp_offset__EZ_SEMI__
    unsigned int fp_offset__EZ_SEMI__
    void *overflow_arg_area__EZ_SEMI__
    void *reg_save_area__EZ_SEMI__
} __va_elem__EZ_SEMI__
typedef __va_elem __builtin_va_list[1]__EZ_SEMI__
#endif
#endif"
    )

    foreach(_line IN LISTS _arch_lines)
        ezmusl_transform_alltypes_line("${_line}" _tline)
        list(APPEND _out_chunks "${_tline}")
    endforeach()

    # Ensure 64-bit pointer/offset types on Windows LLP64 compilers (MinGW/MSVC)
    # while keeping LP64 definitions for Linux and chibicc (__LP64__).
    list(APPEND _out_chunks
"#if defined(_WIN32) && !defined(__LP64__)
#undef _Addr
#undef _Int64
#undef _Reg
#define _Addr long long
#define _Int64 long long
#define _Reg long long
#endif"
    )

    foreach(_line IN LISTS _gen_lines)
        ezmusl_transform_alltypes_line("${_line}" _tline)
        list(APPEND _out_chunks "${_tline}")
    endforeach()

    string(JOIN "\n" _content ${_out_chunks})
    string(REPLACE "__EZ_SEMI__" ";" _content "${_content}")
    get_filename_component(_out_dir "${OUT_FILE}" DIRECTORY)
    file(MAKE_DIRECTORY "${_out_dir}")
    file(WRITE "${OUT_FILE}" "${_content}\n")
endfunction()

function(ezmusl_generate_syscall SYSCALL_IN OUT_FILE)
    file(READ "${SYSCALL_IN}" _raw)
    string(REPLACE "\r\n" "\n" _raw "${_raw}")
    ezmusl_read_lines_preserving_semicolons("${SYSCALL_IN}" _lines)
    set(_sys_lines "")
    foreach(_line IN LISTS _lines)
        if (_line MATCHES "^#define __NR_(.+)$")
            list(APPEND _sys_lines "#define SYS_${CMAKE_MATCH_1}")
        endif ()
    endforeach()
    string(JOIN "\n" _sys_content ${_sys_lines})
    string(REPLACE "__EZ_SEMI__" ";" _sys_content "${_sys_content}")
    get_filename_component(_out_dir "${OUT_FILE}" DIRECTORY)
    file(MAKE_DIRECTORY "${_out_dir}")
    file(WRITE "${OUT_FILE}" "${_raw}\n${_sys_content}\n")
endfunction()

function(ezmusl_generate_version VERSION_FILE OUT_FILE)
    file(READ "${VERSION_FILE}" _ver)
    string(STRIP "${_ver}" _ver)
    get_filename_component(_out_dir "${OUT_FILE}" DIRECTORY)
    file(MAKE_DIRECTORY "${_out_dir}")
    file(WRITE "${OUT_FILE}" "#define VERSION \"${_ver}\"\n")
endfunction()

function(ezmusl_stage_public_headers MUSL_SRC_DIR ARCH GEN_INCLUDE_DIR STAGE_DIR)
    file(MAKE_DIRECTORY "${STAGE_DIR}")
    file(MAKE_DIRECTORY "${STAGE_DIR}/bits")
    file(COPY "${MUSL_SRC_DIR}/include/" DESTINATION "${STAGE_DIR}")
    file(REMOVE "${STAGE_DIR}/alltypes.h.in")
    file(COPY "${MUSL_SRC_DIR}/arch/generic/bits/" DESTINATION "${STAGE_DIR}/bits")
    file(GLOB _arch_bits "${MUSL_SRC_DIR}/arch/${ARCH}/bits/*.h")
    foreach(_hdr IN LISTS _arch_bits)
        file(COPY "${_hdr}" DESTINATION "${STAGE_DIR}/bits")
    endforeach()
    file(COPY "${GEN_INCLUDE_DIR}/bits/alltypes.h" DESTINATION "${STAGE_DIR}/bits")
    file(COPY "${GEN_INCLUDE_DIR}/bits/syscall.h" DESTINATION "${STAGE_DIR}/bits")

    # On Windows LLP64 targets, libEzMusl uses 32-bit long and 64-bit long long,
    # so PRId64/PRIdPTR must expand to "ll" instead of "l" when _WIN32 is defined.
    if (EXISTS "${STAGE_DIR}/inttypes.h")
        file(READ "${STAGE_DIR}/inttypes.h" _inttypes)
        string(REPLACE
            "#if UINTPTR_MAX == UINT64_MAX\n#define __PRI64  \"l\"\n#define __PRIPTR \"l\""
            "#if defined(_WIN32)\n#define __PRI64  \"ll\"\n#define __PRIPTR \"ll\"\n#elif UINTPTR_MAX == UINT64_MAX\n#define __PRI64  \"l\"\n#define __PRIPTR \"l\""
            _inttypes "${_inttypes}"
        )
        file(WRITE "${STAGE_DIR}/inttypes.h" "${_inttypes}")
    endif ()
endfunction()
