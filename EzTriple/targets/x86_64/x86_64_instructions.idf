target AMD64;

// ============================================================================
// INTEGER ARITHMETIC
// ============================================================================

target_inst ADD32rr(GPR32:dst OUT, GPR32:src1 IN, GPR32:src2 IN) {
    MNEMONIC("addl");
    FLAGS(IsCommutative);
};

target_inst ADD32ri(GPR32:dst OUT, GPR32:src1 IN, i32:imm IN) {
    MNEMONIC("addl");
};

target_inst ADD32rm(GPR32:dst OUT, GPR32:src1 IN, Mem32:addr IN) {
    MNEMONIC("addl");
    FLAGS(ReadsMemory);
};

target_inst ADD64rr(GPR64:dst OUT, GPR64:src1 IN, GPR64:src2 IN) {
    MNEMONIC("addq");
    FLAGS(IsCommutative);
};

target_inst ADD64ri(GPR64:dst OUT, GPR64:src1 IN, i64:imm IN) {
    MNEMONIC("addq");
};

target_inst ADD64rm(GPR64:dst OUT, GPR64:src1 IN, Mem64:addr IN) {
    MNEMONIC("addq");
    FLAGS(ReadsMemory);
};

target_inst SUB32rr(GPR32:dst OUT, GPR32:src1 IN, GPR32:src2 IN) {
    MNEMONIC("subl");
};

target_inst SUB32ri(GPR32:dst OUT, GPR32:src1 IN, i32:imm IN) {
    MNEMONIC("subl");
};

target_inst SUB32rm(GPR32:dst OUT, GPR32:src1 IN, Mem32:addr IN) {
    MNEMONIC("subl");
    FLAGS(ReadsMemory);
};

target_inst SUB64rr(GPR64:dst OUT, GPR64:src1 IN, GPR64:src2 IN) {
    MNEMONIC("subq");
};

target_inst SUB64ri(GPR64:dst OUT, GPR64:src1 IN, i64:imm IN) {
    MNEMONIC("subq");
};

target_inst SUB64rm(GPR64:dst OUT, GPR64:src1 IN, Mem64:addr IN) {
    MNEMONIC("subq");
    FLAGS(ReadsMemory);
};

target_inst IMUL32rr(GPR32:dst OUT, GPR32:src1 IN, GPR32:src2 IN) {
    MNEMONIC("imull");
    FLAGS(IsCommutative);
};

target_inst IMUL32ri(GPR32:dst OUT, GPR32:src1 IN, i32:imm IN) {
    MNEMONIC("imull");
};

target_inst IMUL64rr(GPR64:dst OUT, GPR64:src1 IN, GPR64:src2 IN) {
    MNEMONIC("imulq");
    FLAGS(IsCommutative);
};

target_inst IMUL64ri(GPR64:dst OUT, GPR64:src1 IN, i64:imm IN) {
