    FLAGS(ReadsMemory);
};

target_inst LOAD64(GPR64:dst OUT, Mem64:addr IN) {
    MNEMONIC("movq");
    FLAGS(ReadsMemory);
};

target_inst STORE8(Mem8:addr IN, GPR8:val IN) {
    MNEMONIC("movb");
    FLAGS(WritesMemory);
};

target_inst STORE16(Mem16:addr IN, GPR16:val IN) {
    MNEMONIC("movw");
    FLAGS(WritesMemory);
};

target_inst STORE32(Mem32:addr IN, GPR32:val IN) {
    MNEMONIC("movl");
    FLAGS(WritesMemory);
};

target_inst STORE64(Mem64:addr IN, GPR64:val IN) {
    MNEMONIC("movq");
    FLAGS(WritesMemory);
};

