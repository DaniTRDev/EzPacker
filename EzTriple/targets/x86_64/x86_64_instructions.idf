};

target_inst IDIV32r(GPR32:src IN) {
    MNEMONIC("idivl");
};

target_inst IDIV64r(GPR64:src IN) {
    MNEMONIC("idivq");
};

target_inst DIV32r(GPR32:src IN) {
    MNEMONIC("divl");
};

target_inst DIV64r(GPR64:src IN) {
    MNEMONIC("divq");
};

target_inst NEG32r(GPR32:dst OUT, GPR32:src IN) {
    MNEMONIC("negl");
};

target_inst NEG64r(GPR64:dst OUT, GPR64:src IN) {
    MNEMONIC("negq");
};

target_inst NOT32r(GPR32:dst OUT, GPR32:src IN) {
    MNEMONIC("notl");
};

target_inst NOT64r(GPR64:dst OUT, GPR64:src IN) {
