};

target_inst PUSH64r(GPR64:src IN) {
    MNEMONIC("pushq");
    FLAGS(WritesMemory);
};

target_inst POP64r(GPR64:dst OUT) {
    MNEMONIC("popq");
    FLAGS(ReadsMemory);
};

