// ============================================================================
// CONTROL FLOW
// ============================================================================

target_inst JMP(i64:target IN) {
    MNEMONIC("jmp");
    FLAGS(IsTerminator, IsBranch);
};

target_inst JE(i64:target IN) {
    MNEMONIC("je");
    FLAGS(IsTerminator, IsBranch, ReadsCPUFlags);
};

target_inst JNE(i64:target IN) {
    MNEMONIC("jne");
    FLAGS(IsTerminator, IsBranch, ReadsCPUFlags);
};

target_inst JL(i64:target IN) {
    MNEMONIC("jl");
    FLAGS(IsTerminator, IsBranch, ReadsCPUFlags);
};

target_inst JLE(i64:target IN) {
    MNEMONIC("jle");
    FLAGS(IsTerminator, IsBranch, ReadsCPUFlags);
};

target_inst JG(i64:target IN) {
