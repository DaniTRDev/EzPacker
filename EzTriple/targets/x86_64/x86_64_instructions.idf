// DATA MOVEMENT & MEMORY
// ============================================================================

target_inst MOV8rr(GPR8:dst OUT, GPR8:src IN) {
    MNEMONIC("movb");
    FLAGS(IsMove);
};

target_inst MOV8ri(GPR8:dst OUT, i8:imm IN) {
    MNEMONIC("movb");
};

target_inst MOV16rr(GPR16:dst OUT, GPR16:src IN) {
    MNEMONIC("movw");
    FLAGS(IsMove);
};

target_inst MOV16ri(GPR16:dst OUT, i16:imm IN) {
    MNEMONIC("movw");
};

target_inst MOV32rr(GPR32:dst OUT, GPR32:src IN) {
    MNEMONIC("movl");
    FLAGS(IsMove);
};

target_inst MOV32ri(GPR32:dst OUT, i32:imm IN) {
    MNEMONIC("movl");
};

target_inst MOV64rr(GPR64:dst OUT, GPR64:src IN) {
    MNEMONIC("movq");
    FLAGS(IsMove);
};

target_inst MOV64ri(GPR64:dst OUT, i64:imm IN) {
    MNEMONIC("movq");
};

target_inst LOAD8(GPR8:dst OUT, Mem8:addr IN) {
