; Test Suite: 13_vector_simd.mir
; Tests 128-bit (SSE) and 256-bit (AVX/AVX2) vector arithmetic and logic operations
; across float (v4f32, v8f32), double (v2f64, v4f64), and integer (v4i32, v8i32) vector shapes.

; ============================================================================
; 128-bit Single Precision Vector Float Operations (v4f32)
; ============================================================================

fn @vec128_f32_add(v4f32 %a, v4f32 %b) -> v4f32 {
entry:
    %res = VADD v4f32 %a, %b;
    RET v4f32 %res;
}

fn @vec128_f32_sub(v4f32 %a, v4f32 %b) -> v4f32 {
entry:
    %res = VSUB v4f32 %a, %b;
    RET v4f32 %res;
}

fn @vec128_f32_mul(v4f32 %a, v4f32 %b) -> v4f32 {
entry:
    %res = VMUL v4f32 %a, %b;
    RET v4f32 %res;
}

fn @vec128_f32_div(v4f32 %a, v4f32 %b) -> v4f32 {
entry:
    %res = VDIV v4f32 %a, %b;
    RET v4f32 %res;
}

fn @vec128_f32_and(v4f32 %a, v4f32 %b) -> v4f32 {
entry:
    %res = VAND v4f32 %a, %b;
    RET v4f32 %res;
}

fn @vec128_f32_or(v4f32 %a, v4f32 %b) -> v4f32 {
entry:
    %res = VOR v4f32 %a, %b;
    RET v4f32 %res;
}

fn @vec128_f32_xor(v4f32 %a, v4f32 %b) -> v4f32 {
entry:
    %res = VXOR v4f32 %a, %b;
    RET v4f32 %res;
}

