target RiscV64 {
    instructions:  "riscv64_instructions.idf";
    calling_convs: ["riscv64_calling_conv.ezcc"];

    pointer_size: 8;
    stack_slot:   8;

    instruction_pointer: pc;
    mem_disp_type: i64;

    object_formats: [ELF];
    default_calling_conv: LP64D;

    register_bank GPR {
        classes { GPR32: 32, GPR64: 64 }
        sub_register { GPR64 <: GPR32 }
        registers {
            x0  enc 0  names { zero: GPR64, zero: GPR32 }
            x1  enc 1  names { ra:   GPR64, ra:   GPR32 }
            x2  enc 2  names { sp:   GPR64, sp:   GPR32 }
            x3  enc 3  names { gp:   GPR64, gp:   GPR32 }
            x4  enc 4  names { tp:   GPR64, tp:   GPR32 }
            x5  enc 5  names { t0:   GPR64, t0:   GPR32 }
            x6  enc 6  names { t1:   GPR64, t1:   GPR32 }
            x7  enc 7  names { t2:   GPR64, t2:   GPR32 }
            x8  enc 8  names { s0:   GPR64, s0:   GPR32 }
            x9  enc 9  names { s1:   GPR64, s1:   GPR32 }
            x10 enc 10 names { a0:   GPR64, a0:   GPR32 }
            x11 enc 11 names { a1:   GPR64, a1:   GPR32 }
            x12 enc 12 names { a2:   GPR64, a2:   GPR32 }
            x13 enc 13 names { a3:   GPR64, a3:   GPR32 }
            x14 enc 14 names { a4:   GPR64, a4:   GPR32 }
            x15 enc 15 names { a5:   GPR64, a5:   GPR32 }
            x16 enc 16 names { a6:   GPR64, a6:   GPR32 }
            x17 enc 17 names { a7:   GPR64, a7:   GPR32 }
            x18 enc 18 names { s2:   GPR64, s2:   GPR32 }
            x19 enc 19 names { s3:   GPR64, s3:   GPR32 }
            x20 enc 20 names { s4:   GPR64, s4:   GPR32 }
            x21 enc 21 names { s5:   GPR64, s5:   GPR32 }
            x22 enc 22 names { s6:   GPR64, s6:   GPR32 }
            x23 enc 23 names { s7:   GPR64, s7:   GPR32 }
            x24 enc 24 names { s8:   GPR64, s8:   GPR32 }
            x25 enc 25 names { s9:   GPR64, s9:   GPR32 }
            x26 enc 26 names { s10:  GPR64, s10:  GPR32 }
            x27 enc 27 names { s11:  GPR64, s11:  GPR32 }
            x28 enc 28 names { t3:   GPR64, t3:   GPR32 }
            x29 enc 29 names { t4:   GPR64, t4:   GPR32 }
            x30 enc 30 names { t5:   GPR64, t5:   GPR32 }
            x31 enc 31 names { t6:   GPR64, t6:   GPR32 }
        }
    }

    register_bank FPR {
        classes { FPR32: 32, FPR64: 64 }
        sub_register { FPR64 <: FPR32 }
        registers {
            f0  enc 0  names { ft0:  FPR64, ft0:  FPR32 }
            f1  enc 1  names { ft1:  FPR64, ft1:  FPR32 }
            f2  enc 2  names { ft2:  FPR64, ft2:  FPR32 }
            f3  enc 3  names { ft3:  FPR64, ft3:  FPR32 }
            f4  enc 4  names { ft4:  FPR64, ft4:  FPR32 }
            f5  enc 5  names { ft5:  FPR64, ft5:  FPR32 }
            f6  enc 6  names { ft6:  FPR64, ft6:  FPR32 }
            f7  enc 7  names { ft7:  FPR64, ft7:  FPR32 }
            f8  enc 8  names { fs0:  FPR64, fs0:  FPR32 }
            f9  enc 9  names { fs1:  FPR64, fs1:  FPR32 }
            f10 enc 10 names { fa0:  FPR64, fa0:  FPR32 }
            f11 enc 11 names { fa1:  FPR64, fa1:  FPR32 }
            f12 enc 12 names { fa2:  FPR64, fa2:  FPR32 }
            f13 enc 13 names { fa3:  FPR64, fa3:  FPR32 }
            f14 enc 14 names { fa4:  FPR64, fa4:  FPR32 }
            f15 enc 15 names { fa5:  FPR64, fa5:  FPR32 }
            f16 enc 16 names { fa6:  FPR64, fa6:  FPR32 }
            f17 enc 17 names { fa7:  FPR64, fa7:  FPR32 }
            f18 enc 18 names { fs2:  FPR64, fs2:  FPR32 }
            f19 enc 19 names { fs3:  FPR64, fs3:  FPR32 }
            f20 enc 20 names { fs4:  FPR64, fs4:  FPR32 }
            f21 enc 21 names { fs5:  FPR64, fs5:  FPR32 }
            f22 enc 22 names { fs6:  FPR64, fs6:  FPR32 }
            f23 enc 23 names { fs7:  FPR64, fs7:  FPR32 }
            f24 enc 24 names { fs8:  FPR64, fs8:  FPR32 }
            f25 enc 25 names { fs9:  FPR64, fs9:  FPR32 }
            f26 enc 26 names { fs10: FPR64, fs10: FPR32 }
            f27 enc 27 names { fs11: FPR64, fs11: FPR32 }
            f28 enc 28 names { ft8:  FPR64, ft8:  FPR32 }
            f29 enc 29 names { ft9:  FPR64, ft9:  FPR32 }
            f30 enc 30 names { ft10: FPR64, ft10: FPR32 }
            f31 enc 31 names { ft11: FPR64, ft11: FPR32 }
        }
    }

    register_bank VR {
        classes { VR128: 128 }
        registers {
            v0  enc 0  names { v0:  VR128 }
            v1  enc 1  names { v1:  VR128 }
            v2  enc 2  names { v2:  VR128 }
            v3  enc 3  names { v3:  VR128 }
            v4  enc 4  names { v4:  VR128 }
            v5  enc 5  names { v5:  VR128 }
            v6  enc 6  names { v6:  VR128 }
            v7  enc 7  names { v7:  VR128 }
            v8  enc 8  names { v8:  VR128 }
            v9  enc 9  names { v9:  VR128 }
            v10 enc 10 names { v10: VR128 }
            v11 enc 11 names { v11: VR128 }
            v12 enc 12 names { v12: VR128 }
            v13 enc 13 names { v13: VR128 }
            v14 enc 14 names { v14: VR128 }
            v15 enc 15 names { v15: VR128 }
            v16 enc 16 names { v16: VR128 }
            v17 enc 17 names { v17: VR128 }
            v18 enc 18 names { v18: VR128 }
            v19 enc 19 names { v19: VR128 }
            v20 enc 20 names { v20: VR128 }
            v21 enc 21 names { v21: VR128 }
            v22 enc 22 names { v22: VR128 }
            v23 enc 23 names { v23: VR128 }
            v24 enc 24 names { v24: VR128 }
            v25 enc 25 names { v25: VR128 }
            v26 enc 26 names { v26: VR128 }
            v27 enc 27 names { v27: VR128 }
            v28 enc 28 names { v28: VR128 }
            v29 enc 29 names { v29: VR128 }
            v30 enc 30 names { v30: VR128 }
            v31 enc 31 names { v31: VR128 }
        }
    }

    special {
        pc: 32
    }

    extensions {
        rv64m {
            default: true;
            description: "Standard Extension for Integer Multiplication and Division";
        };
        rv64a {
            default: true;
            description: "Standard Extension for Atomic Instructions";
        };
        rv64f {
            default: true;
            description: "Standard Extension for Single-Precision Floating-Point";
        };
        rv64d {
            default: true;
            implies: [rv64f];
            description: "Standard Extension for Double-Precision Floating-Point";
        };
        rv64v {
            default: true;
            implies: [rv64d];
            description: "Standard Extension for Vector Operations";
        };
        rv64c {
            default: false;
            description: "Standard Extension for Compressed Instructions";
        };
    }

    libcalls {
        __divdi3:      "__divdi3";
        __udivdi3:     "__udivdi3";
        __moddi3:      "__moddi3";
        __umoddi3:     "__umoddi3";
        __divti3:      "__divti3";
        __udivti3:     "__udivti3";
        __modti3:      "__modti3";
        __umodti3:     "__umodti3";
        __multi3:      "__multi3";
        __ashlti3:     "__ashlti3";
        __lshrti3:     "__lshrti3";
        __ashrti3:     "__ashrti3";
        memcpy:        "memcpy";
        memmove:       "memmove";
        memset:        "memset";
        memcmp:        "memcmp";
        bzero:         "bzero"
    }

    components {
        frame_lowerer:        RiscV64FrameLowerer;
        instruction_selector: RiscV64TargetInstructionSelector;
        register_allocator:   RiscV64RegisterAllocator;
        code_emitter:         RiscV64CodeEmitter;
        relocation_resolver:  RiscV64RelocationResolver
    }
}
