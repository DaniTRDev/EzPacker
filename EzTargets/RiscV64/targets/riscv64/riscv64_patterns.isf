// ============================================================================
// DATA MOVEMENT PATTERNS
// ============================================================================

pattern Select_MOV64rr [cost = 1] {
    match {
        MOV i64:$dst, i64:$src;
    };
    select {
        MV GPR64:$dst, GPR64:$src;
    };
};

pattern Select_MOV32rr [cost = 1] {
    match {
        MOV i32:$dst, i32:$src;
    };
    select {
        MV GPR32:$dst, GPR32:$src;
    };
};

pattern Select_MOVptr [cost = 1] {
    match {
        MOV ptr:$dst, ptr:$src;
    };
    select {
        MV GPR64:$dst, GPR64:$src;
    };
};

pattern Select_MOV64ri [cost = 1] {
    match {
        MOV i64:$dst, imm(i64):$imm;
    };
    when {
        isSimm12($imm);
    };
    select {
        ADDI64ri GPR64:$dst, GPR64:$dst, $imm;
    };
};

pattern Select_MOV32ri [cost = 1] {
    match {
        MOV i32:$dst, imm(i32):$imm;
    };
    when {
        isSimm12($imm);
    };
    select {
        ADDI32ri GPR32:$dst, GPR32:$dst, $imm;
    };
};

// ============================================================================
// MEMORY ACCESS PATTERNS
// ============================================================================

pattern Select_LD [cost = 2] {
    match {
        LOAD i64:$dst, AddrModeRegImm($base, $disp);
    };
    select {
        LD GPR64:$dst, GPR64:$base, $disp;
    };
};

pattern Select_LW [cost = 2] {
    match {
        LOAD i32:$dst, AddrModeRegImm($base, $disp);
    };
    select {
        LW GPR64:$dst, GPR64:$base, $disp;
    };
};

pattern Select_LOADptr [cost = 2] {
    match {
        LOAD ptr:$dst, AddrModeRegImm($base, $disp);
    };
    select {
        LD GPR64:$dst, GPR64:$base, $disp;
    };
};

pattern Select_SD [cost = 2] {
    match {
        STORE AddrModeRegImm($base, $disp), i64:$src;
    };
    select {
        SD GPR64:$src, GPR64:$base, $disp;
    };
};

pattern Select_SW [cost = 2] {
    match {
        STORE AddrModeRegImm($base, $disp), i32:$src;
    };
    select {
        SW GPR64:$src, GPR64:$base, $disp;
    };
};

pattern Select_STOREptr [cost = 2] {
    match {
        STORE AddrModeRegImm($base, $disp), ptr:$src;
    };
    select {
        SD GPR64:$src, GPR64:$base, $disp;
    };
};

// ============================================================================
// CONTROL FLOW PATTERNS
// ============================================================================

pattern Select_JMP [cost = 1] {
    match {
        JMP ptr:$target;
    };
    select {
        JALR GPR64:$target, GPR64:$target, 0;
    };
};
