// ============================================================================
// DATA MOVEMENT PATTERNS
// ============================================================================

pattern Select_MOV64rr [cost = 1] {
    match {
        MOV i64:$dst, i64:$src;
    };
    select {
        MV GPR64:$dst, GPR64:$src;
    };
};

pattern Select_MOV32rr [cost = 1] {
    match {
        MOV i32:$dst, i32:$src;
    };
    select {
        MV GPR32:$dst, GPR32:$src;
    };
};

pattern Select_MOVptr [cost = 1] {
    match {
        MOV ptr:$dst, ptr:$src;
    };
    select {
        MV GPR64:$dst, GPR64:$src;
    };
};

// ============================================================================
// CONTROL FLOW PATTERNS
// ============================================================================

pattern Select_RET [cost = 1] {
    match {
        RET;
    };
    select {
        RET;
    };
};

// ============================================================================
// FLOATING-POINT ALU PATTERNS
// ============================================================================

pattern Select_FADD32rr [cost = 1] {
    match {
        FADD f32:$dst, f32:$src1, f32:$src2;
    };
    when {
        hasExtension("rv64f");
    };
    select {
        FADD_S FPR32:$dst, FPR32:$src1, FPR32:$src2;
    };
};

pattern Select_FADD64rr [cost = 1] {
    match {
        FADD f64:$dst, f64:$src1, f64:$src2;
    };
    when {
        hasExtension("rv64d");
    };
    select {
        FADD_D FPR64:$dst, FPR64:$src1, FPR64:$src2;
    };
};

