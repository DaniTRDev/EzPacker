target RiscV64;

addrmode AddrModeRegImm(GPR64:base, simm12:disp = 0) {
    variant BaseDisp {
        match {
            ADD ptr:$base, imm(i32):$disp;
        };
        when {
            isSimm12($disp);
        };
    };
    variant BaseOnly {
        match {
            ptr:$base;
        };
    };
};

// ============================================================================
// ARITHMETIC PATTERNS
// ============================================================================

pattern Select_ADD64ri [cost = 1] {
    match {
        ADD i64:$dst, i64:$src1, imm(i64):$imm;
    };
    when {
        isSimm12($imm);
    };
    select {
        ADDI64ri GPR64:$dst, GPR64:$src1, $imm;
    };
};

pattern Select_ADD64rr [cost = 1] {
    match {
        ADD i64:$dst, i64:$src1, i64:$src2;
    };
    select {
        ADD64rr GPR64:$dst, GPR64:$src1, GPR64:$src2;
    };
};

pattern Select_ADD32ri [cost = 1] {
    match {
        ADD i32:$dst, i32:$src1, imm(i32):$imm;
    };
    when {
        isSimm12($imm);
    };
    select {
        ADDI32ri GPR32:$dst, GPR32:$src1, $imm;
    };
};

pattern Select_ADD32rr [cost = 1] {
    match {
        ADD i32:$dst, i32:$src1, i32:$src2;
    };
    select {
        ADD32rr GPR32:$dst, GPR32:$src1, GPR32:$src2;
    };
};

pattern Select_SUB64rr [cost = 1] {
    match {
        SUB i64:$dst, i64:$src1, i64:$src2;
    };
    select {
        SUB64rr GPR64:$dst, GPR64:$src1, GPR64:$src2;
    };
};

pattern Select_SUB32rr [cost = 1] {
    match {
        SUB i32:$dst, i32:$src1, i32:$src2;
    };
    select {
        SUB32rr GPR32:$dst, GPR32:$src1, GPR32:$src2;
    };
};

