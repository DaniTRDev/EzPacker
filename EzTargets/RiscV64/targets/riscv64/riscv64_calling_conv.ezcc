calling_convention LP64D {
    stack {
        align: 16,
        growth: down,
        cleanup: caller,
        shadow_space: 0,
        red_zone: 0,
        sp: sp,
        fp: s0
    }

    preserve callee: [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, sp, fs0, fs1, fs2, fs3, fs4, fs5, fs6, fs7, fs8, fs9, fs10, fs11]
    preserve caller: [ra, t0, t1, t2, t3, t4, t5, t6, a0, a1, a2, a3, a4, a5, a6, a7, ft0, ft1, ft2, ft3, ft4, ft5, ft6, ft7, fa0, fa1, fa2, fa3, fa4, fa5, fa6, fa7, ft8, ft9, ft10, ft11, v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31]

    classify {
        types [i1, i8, i16, i32, i64, ptr] => integer
        types [f32, f64, v16i8, v8i16, v4i32, v2i64, v4f32, v2f64] => float
    }

    arguments {
        pass integer => seq([a0, a1, a2, a3, a4, a5, a6, a7]), fallback: stack(8)
        pass float => seq([fa0, fa1, fa2, fa3, fa4, fa5, fa6, fa7]), fallback: stack(8)
    }

    returns {
        sret {
            ptr: a0,
            consumes_slot: true,
            returns: a0
        }
        pass integer => seq([a0, a1])
        pass float => seq([fa0, fa1])
    }
}
