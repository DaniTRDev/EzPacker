        operands { dst => rd; base => rs1; disp => imm12_signed; };
    };
};

target_inst LB(GPR64:dst OUT, GPR64:base IN, i64:disp IN) {
    MNEMONIC("lb");
    FLAGS(ReadsMemory);
    ENCODING {
        form: i_type;
