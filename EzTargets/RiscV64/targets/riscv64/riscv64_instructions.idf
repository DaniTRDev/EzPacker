    MNEMONIC("sd");
    FLAGS(WritesMemory);
    ENCODING {
        form: s_type;
        opcode: [0x23];
        funct3: 0x3;
        operands { src => rs2; base => rs1; disp => imm12_store; };
    };
};

target_inst SW(GPR64:src IN, GPR64:base IN, i64:disp IN) {
    MNEMONIC("sw");
    FLAGS(WritesMemory);
