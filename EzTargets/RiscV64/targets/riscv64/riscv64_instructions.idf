// ============================================================================
// BRANCH & CONTROL FLOW
// ============================================================================

target_inst BEQ(GPR64:src1 IN, GPR64:src2 IN, i64:target IN) {
    MNEMONIC("beq");
    FLAGS(IsBranch);
    ENCODING {
        form: b_type;
        opcode: [0x63];
        funct3: 0x0;
        operands { src1 => rs1; src2 => rs2; target => imm12_branch; };
    };
};

target_inst BNE(GPR64:src1 IN, GPR64:src2 IN, i64:target IN) {
    MNEMONIC("bne");
    FLAGS(IsBranch);
    ENCODING {
        form: b_type;
        opcode: [0x63];
        funct3: 0x1;
        operands { src1 => rs1; src2 => rs2; target => imm12_branch; };
    };
};

target_inst BLT(GPR64:src1 IN, GPR64:src2 IN, i64:target IN) {
    MNEMONIC("blt");
    FLAGS(IsBranch);
    ENCODING {
        form: b_type;
        opcode: [0x63];
        funct3: 0x4;
        operands { src1 => rs1; src2 => rs2; target => imm12_branch; };
    };
};

target_inst BGE(GPR64:src1 IN, GPR64:src2 IN, i64:target IN) {
    MNEMONIC("bge");
    FLAGS(IsBranch);
    ENCODING {
        form: b_type;
        opcode: [0x63];
        funct3: 0x5;
        operands { src1 => rs1; src2 => rs2; target => imm12_branch; };
