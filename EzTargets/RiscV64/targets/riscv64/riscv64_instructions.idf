// ============================================================================
// MEMORY ACCESS (LOADS & STORES)
// ============================================================================

target_inst LD(GPR64:dst OUT, GPR64:base IN, i64:disp IN) {
    MNEMONIC("ld");
    FLAGS(ReadsMemory);
    ENCODING {
        form: i_type;
        opcode: [0x03];
        funct3: 0x3;
        operands { dst => rd; base => rs1; disp => imm12_signed; };
    };
};

target_inst LW(GPR64:dst OUT, GPR64:base IN, i64:disp IN) {
    MNEMONIC("lw");
    FLAGS(ReadsMemory);
    ENCODING {
