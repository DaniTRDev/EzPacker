// ============================================================================

target_inst RET() {
    MNEMONIC("ret");
    FLAGS(IsReturn);
    ENCODING {
        form: pseudo;
    };
};

target_inst CALL(GPR64:target IN) {
    MNEMONIC("call");
    FLAGS(IsCall);
    ENCODING {
        form: pseudo;
        operands { target => rel; };
    };
};

target_inst NOP() {
    MNEMONIC("nop");
    ENCODING {
        form: i_type;
        opcode: [0x13];
        funct3: 0x0;
    };
};

