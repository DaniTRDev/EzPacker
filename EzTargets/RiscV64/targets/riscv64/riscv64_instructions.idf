target RiscV64;

// ============================================================================
// INTEGER ARITHMETIC & LOGIC (64-bit and 32-bit)
// ============================================================================

target_inst ADD64rr(GPR64:dst OUT, GPR64:src1 IN, GPR64:src2 IN) {
    MNEMONIC("add");
    FLAGS(IsCommutative);
    ENCODING {
        form: r_type;
        opcode: [0x33];
        funct3: 0x0;
        funct7: 0x00;
        operands { dst => rd; src1 => rs1; src2 => rs2; };
    };
};

target_inst ADDI64ri(GPR64:dst OUT, GPR64:src1 IN, i64:imm IN) {
    MNEMONIC("addi");
    ENCODING {
        form: i_type;
        opcode: [0x13];
        funct3: 0x0;
        operands { dst => rd; src1 => rs1; imm => imm12_signed; };
    };
};

target_inst SUB64rr(GPR64:dst OUT, GPR64:src1 IN, GPR64:src2 IN) {
    MNEMONIC("sub");
