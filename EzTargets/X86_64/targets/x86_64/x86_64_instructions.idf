// ============================================================================
// DATA MOVEMENT & MEMORY
// ============================================================================

target_inst MOV8rr(GPR8:dst OUT, GPR8:src IN) {
    MNEMONIC("movb");
    FLAGS(IsMove);
    ENCODING {
        form: rr;
        opcode: [0x89];
        byte_rex: true;
        operands { src => reg; dst => rm_reg; };
        size: dst;
    };
};

target_inst MOV8ri(GPR8:dst OUT, i8:imm IN) {
    MNEMONIC("movb");
    ENCODING {
        form: movri;
        opcode: [0xB8];
        byte_rex: true;
        operands { dst => reg; imm => imm8; };
        size: dst;
    };
};

