// ============================================================================
// COMPARISONS & SETcc
// ============================================================================

target_inst CMP32rr(GPR32:lhs IN, GPR32:rhs IN) {
    MNEMONIC("cmpl");
    FLAGS(ReadsCPUFlags, WritesCPUFlags);
    ENCODING {
        form: rr;
        opcode: [0x39];
        operands { rhs => reg; lhs => rm_reg; };
        size: lhs;
    };
};

target_inst CMP32ri(GPR32:lhs IN, i32:imm IN) {
    MNEMONIC("cmpl");
    FLAGS(ReadsCPUFlags, WritesCPUFlags);
    ENCODING {
        form: ri;
        opcode: [0x83];
        opcode_digit: 7;
        operands { lhs => rm_reg; imm => imm8_signed; };
        size: lhs;
    };
};

target_inst CMP64rr(GPR64:lhs IN, GPR64:rhs IN) {
    MNEMONIC("cmpq");
    FLAGS(ReadsCPUFlags, WritesCPUFlags);
    ENCODING {
        form: rr;
        opcode: [0x39];
        rex_w: true;
        operands { rhs => reg; lhs => rm_reg; };
        size: lhs;
    };
};

