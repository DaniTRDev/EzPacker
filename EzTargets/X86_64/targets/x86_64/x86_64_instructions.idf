        size: dst;
    };
};

target_inst SUB32rm(GPR32:dst OUT, GPR32:src1 IN, Mem32:addr IN) {
    MNEMONIC("subl");
    FLAGS(ReadsMemory);
    ENCODING {
        form: rm;
        opcode: [0x2B];
