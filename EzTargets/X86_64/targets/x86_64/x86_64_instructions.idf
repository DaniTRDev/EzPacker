    MNEMONIC("cmpq");
    FLAGS(ReadsCPUFlags, WritesCPUFlags);
    ENCODING {
        form: ri;
        opcode: [0x83];
        opcode_digit: 7;
        rex_w: true;
        operands { lhs => rm_reg; imm => imm8_signed; };
        size: lhs;
    };
};

