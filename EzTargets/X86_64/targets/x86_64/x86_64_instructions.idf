target AMD64;

// ============================================================================
// INTEGER ARITHMETIC
// ============================================================================

target_inst ADD32rr(GPR32:dst OUT, GPR32:src1 IN, GPR32:src2 IN) {
    MNEMONIC("addl");
    FLAGS(IsCommutative);
    ENCODING {
        form: rr;
        opcode: [0x01];
        operands { src2 => reg; dst => rm_reg; };
        coalesce: src1;
        size: dst;
    };
};

target_inst ADD32ri(GPR32:dst OUT, GPR32:src1 IN, i32:imm IN) {
    MNEMONIC("addl");
    ENCODING {
        form: ri;
        opcode: [0x83];
        opcode_digit: 0;
        operands { dst => rm_reg; imm => imm8_signed; };
        coalesce: src1;
        size: dst;
    };
};

target_inst ADD32rm(GPR32:dst OUT, GPR32:src1 IN, Mem32:addr IN) {
    MNEMONIC("addl");
    FLAGS(ReadsMemory);
    ENCODING {
        form: rm;
        opcode: [0x03];
        operands { dst => reg; addr => rm_mem; };
        coalesce: src1;
        size: dst;
    };
};

target_inst ADD64rr(GPR64:dst OUT, GPR64:src1 IN, GPR64:src2 IN) {
    MNEMONIC("addq");
    FLAGS(IsCommutative);
    ENCODING {
        form: rr;
        opcode: [0x01];
        rex_w: true;
        operands { src2 => reg; dst => rm_reg; };
        coalesce: src1;
        size: dst;
    };
};

target_inst ADD64ri(GPR64:dst OUT, GPR64:src1 IN, i64:imm IN) {
    MNEMONIC("addq");
    ENCODING {
        form: ri;
        opcode: [0x83];
        opcode_digit: 0;
        rex_w: true;
        operands { dst => rm_reg; imm => imm8_signed; };
        coalesce: src1;
        size: dst;
    };
};

target_inst ADD64rm(GPR64:dst OUT, GPR64:src1 IN, Mem64:addr IN) {
    MNEMONIC("addq");
    FLAGS(ReadsMemory);
    ENCODING {
        form: rm;
        opcode: [0x03];
        rex_w: true;
        operands { dst => reg; addr => rm_mem; };
        coalesce: src1;
        size: dst;
    };
};

target_inst SUB32rr(GPR32:dst OUT, GPR32:src1 IN, GPR32:src2 IN) {
