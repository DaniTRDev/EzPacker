target_inst SYSCALL() {
    MNEMONIC("syscall");
    FLAGS(HasSideEffect);
    ENCODING { form: syscall; opcode: [0x0F, 0x05]; };
};

target_inst NOP() {
    MNEMONIC("nop");
    ENCODING { form: nop; opcode: [0x90]; };
};
