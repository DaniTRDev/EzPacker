target AMD64;

addrmode AddrModeRegImm(GPR64:base, simm32:disp = 0) {
    variant BaseDisp {
        match {
            ADD ptr:$base, imm(i32):$disp;
        };
        when {
            isSimm32($disp);
        };
    };
    variant BaseOnly {
        match {
            ptr:$base;
        };
    };
};

// ============================================================================
// Arithmetic Patterns (with load-folding)
// ============================================================================

pattern Select_ADD64rm [cost = 2] {
    match {
        ADD i64:$dst, i64:$src1, (LOAD i64:$tmp, AddrModeRegImm($base, $disp));
    };
    when {
        hasOneUse($tmp);
        noInterveningStore($tmp);
    };
    select {
        ADD64rm GPR64:$dst, GPR64:$src1, [$base, $disp];
    };
};

pattern Select_ADD64ri [cost = 1] {
    match {
        ADD i64:$dst, i64:$src1, imm(i64):$imm;
    };
    when {
        isSimm32($imm);
    };
    select {
        ADD64ri GPR64:$dst, GPR64:$src1, $imm;
    };
};

pattern Select_ADD64rr [cost = 1] {
    match {
        ADD i64:$dst, i64:$src1, i64:$src2;
    };
    select {
        ADD64rr GPR64:$dst, GPR64:$src1, GPR64:$src2;
    };
};

pattern Select_ADD32ri [cost = 1] {
    match {
        ADD i32:$dst, i32:$src1, imm(i32):$imm;
    };
    when {
        isSimm32($imm);
    };
    select {
        ADD32ri GPR32:$dst, GPR32:$src1, $imm;
    };
};

pattern Select_ADD32rr [cost = 1] {
    match {
        ADD i32:$dst, i32:$src1, i32:$src2;
    };
    select {
        ADD32rr GPR32:$dst, GPR32:$src1, GPR32:$src2;
    };
};

pattern Select_SUB64ri [cost = 1] {
    match {
        SUB i64:$dst, i64:$src1, imm(i64):$imm;
    };
    when {
        isSimm32($imm);
    };
    select {
        SUB64ri GPR64:$dst, GPR64:$src1, $imm;
    };
};

pattern Select_SUB64rr [cost = 1] {
    match {
        SUB i64:$dst, i64:$src1, i64:$src2;
    };
    select {
        SUB64rr GPR64:$dst, GPR64:$src1, GPR64:$src2;
    };
};

pattern Select_SUB32ri [cost = 1] {
    match {
        SUB i32:$dst, i32:$src1, imm(i32):$imm;
