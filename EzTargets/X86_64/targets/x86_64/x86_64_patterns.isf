// ============================================================================
// Data Movement Patterns
// ============================================================================

pattern Select_MOV64ri [cost = 2] {
    match {
        MOV i64:$dst, imm(i64):$imm;
    };
    when {
        isSimm32($imm);
    };
    select {
        MOV64ri GPR64:$dst, $imm;
    };
};

pattern Select_MOV64rr [cost = 1] {
    match {
        MOV i64:$dst, i64:$src;
    };
    select {
        MOV64rr GPR64:$dst, GPR64:$src;
    };
};

pattern Select_MOV32ri [cost = 2] {
    match {
        MOV i32:$dst, imm(i32):$imm;
    };
    when {
        isSimm32($imm);
    };
    select {
        MOV32ri GPR32:$dst, $imm;
    };
};

pattern Select_MOV32rr [cost = 1] {
    match {
        MOV i32:$dst, i32:$src;
    };
    select {
        MOV32rr GPR32:$dst, GPR32:$src;
    };
};

pattern Select_RET [cost = 1] {
    match {
        RET;
    };
    select {
        RET;
    };
};
