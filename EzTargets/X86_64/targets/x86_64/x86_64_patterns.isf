pattern Select_VMAX_v4i32 [cost = 1] {
    match {
        VMAX v4i32:$dst, v4i32:$src1, v4i32:$src2;
    };
    when {
        hasExtension("sse4_1");
    };
    select {
        PMAXSDrr VR128:$dst, VR128:$src1, VR128:$src2;
    };
};

