void ProcessArray(i64 %arrayPtr, i32 %size, i64 %mask, i32 %threshold)
{
    create i32 %idx;
    create i64 %addr;
    create i64 %val;
    create i64 %processed;
    create i32 %aboveCount;
    create i32 %belowCount;

    mov %idx, 0;
    mov %addr, %arrayPtr;
    mov %aboveCount, 0;
    mov %belowCount, 0;

    while (%idx LT %size)
    {
        mov %val, i64 (%addr+0);
        mov %processed, %val;
        and %processed, %mask;

        if (%processed GT %threshold)
        {
            add %aboveCount, 1;
            shr %processed, 1;
        }
        else if (%processed LT %threshold)
        {
            add %belowCount, 1;
            shl %processed, 1;
        }
        else
        {
            xor %processed, 0xAAAA;
        }

        add %addr, 8;
        add %idx, 1;
    }

    # Summary label
    label_summary:
    {
        if (%aboveCount GT %belowCount)
        {
            nop;
        }
        else
        {
            nop;
        }
    }
}

