void ComplexTransform(i64 %srcPtr, i64 %dstPtr, i32 %length, i64 %key, i32 %mode)
{
    create i32 %idx;
    create i64 %srcAddr;
    create i64 %dstAddr;
    create i64 %val;
    create i64 %transformed;
    create i64 %temp;

    mov %idx, 0;
    mov %srcAddr, %srcPtr;
    mov %dstAddr, %dstPtr;

    while (%idx LT %length)
    {
        mov %val, i64 (%srcAddr+0);
        mov %transformed, %val;

        if (%mode EQ 0)
        {
            # XOR mode
            xor %transformed, %key;
        }
        else if (%mode EQ 1)
        {
            # Shift mode
            mov %temp, %transformed;
            shl %temp, 5;
            xor %transformed, %temp;
            shr %transformed, 3;
            add %transformed, %key;
        }
        else if (%mode EQ 2)
        {
            # Mix mode
            mov %temp, %key;
            and %temp, 0xFF;
            xor %transformed, %temp;
            shl %transformed, 1;
            and %transformed, 0xFFFFFFFF;
        }
        else
        {
            # Default: add
            add %transformed, %key;
            and %transformed, 0xFFFFFFFF;
        }

        # Inner conditional
        if (%transformed GT 0xFFFF)
        {
            and %transformed, 0xFFFF;
        }

        add %srcAddr, 8;
        add %dstAddr, 8;
        add %idx, 1;
    }

    label_complete:
    {
        nop;
    }
}

