# Multi-module stress test
# Exercises: many modules in a single file, different signatures, all return types,
# mixed parameter counts, varied bodies

void InitializeBuffer(i64 %bufPtr, i32 %size)
{
    create i32 %i;
    create i64 %addr;
    mov %i, 0;
    mov %addr, %bufPtr;

    while (%i LT %size)
    {
        mov %addr, %bufPtr;
        add %addr, %i;
        add %i, 1;
    }
    nop;
}

i64 ComputeHash(i64 %dataPtr, i32 %length, i64 %seed)
{
    create i64 %hash;
    create i32 %idx;
    create i64 %curAddr;
    create i64 %val;
    create i64 %mix;

    mov %hash, %seed;
    mov %idx, 0;
    mov %curAddr, %dataPtr;

    while (%idx LT %length)
    {
        mov %val, i64 (%curAddr+0);
        mov %mix, %val;
        shl %mix, 5;
        xor %mix, %val;
        add %hash, %mix;
        xor %hash, 0xFF00FF00;
        shr %hash, 1;
        or %hash, 0x1;

        add %curAddr, 8;
        add %idx, 1;
    }

    label_finalize_hash:
    {
        xor %hash, %seed;
        and %hash, 0xFFFFFFFF;
        nop;
    }
}

i32 FindMaxElement(i64 %arrayPtr, i32 %count)
{
    create i32 %maxVal;
    create i32 %current;
    create i32 %idx;
    create i64 %addr;

    mov %idx, 0;
    mov %addr, %arrayPtr;
    mov %maxVal, i32 (%addr+0);
    add %idx, 1;
    add %addr, 4;

    while (%idx LT %count)
    {
        mov %current, i32 (%addr+0);
        if (%current GT %maxVal)
        {
            mov %maxVal, %current;
        }
        add %addr, 4;
        add %idx, 1;
    }

    nop;
}

i32 CountMatches(i64 %arrayPtr, i32 %size, i32 %target)
{
    create i32 %count;
    create i32 %idx;
    create i64 %addr;
    create i32 %val;

    mov %count, 0;
    mov %idx, 0;
    mov %addr, %arrayPtr;

    while (%idx LT %size)
    {
        mov %val, i32 (%addr+0);
        if (%val EQ %target)
        {
            add %count, 1;
        }
        add %addr, 4;
        add %idx, 1;
    }

