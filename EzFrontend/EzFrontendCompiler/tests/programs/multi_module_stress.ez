void BubbleSortPass(i64 %arrayPtr, i32 %size)
{
    create i32 %i;
    create i32 %limit;
    create i64 %addr;
    create i32 %current;
    create i32 %next;
    create i32 %temp;

    mov %limit, %size;
    sub %limit, 1;
    mov %i, 0;
    mov %addr, %arrayPtr;

    while (%i LT %limit)
    {
        mov %current, i32 (%addr+0);
        mov %next, i32 (%addr+4);

        if (%current GT %next)
        {
            # Swap
            mov %temp, %current;
            mov %current, %next;
            mov %next, %temp;
        }

        add %addr, 4;
        add %i, 1;
    }

    nop;
}

i64 DotProduct(i64 %vecA, i64 %vecB, i32 %dimensions)
{
    create i64 %result;
    create i32 %idx;
    create i64 %addrA;
    create i64 %addrB;
    create i64 %valA;
    create i64 %valB;
    create i64 %prod;

    mov %result, 0;
    mov %idx, 0;
    mov %addrA, %vecA;
    mov %addrB, %vecB;

    while (%idx LT %dimensions)
    {
        mov %valA, i64 (%addrA+0);
        mov %valB, i64 (%addrB+0);
        mov %prod, %valA;
        mul %prod, %valB;
        add %result, %prod;

        add %addrA, 8;
        add %addrB, 8;
        add %idx, 1;
    }

    nop;
}

void MemoryFill(i64 %dstPtr, i32 %size, i64 %value)
{
    create i32 %idx;
    create i64 %addr;

    mov %idx, 0;
    mov %addr, %dstPtr;

    while (%idx LT %size)
    {
        # Write the value at current address
        mov %addr, %dstPtr;
        add %addr, %idx;
        add %idx, 1;
    }

    nop;
}

i64 BitwiseMixer(i64 %input, i64 %key, i32 %rounds)
{
    create i64 %state;
    create i32 %round;
    create i64 %temp;

    mov %state, %input;
    mov %round, 0;

    while (%round LT %rounds)
    {
        # Forward mixing
        mov %temp, %state;
        shl %temp, 13;
        xor %state, %temp;

        mov %temp, %state;
        shr %temp, 7;
        xor %state, %temp;

        mov %temp, %state;
        shl %temp, 17;
        xor %state, %temp;

        # Key injection
        xor %state, %key;
        add %state, %round;

        # Conditional path
        if (%state GT 0xFFFFFFFF)
        {
            and %state, 0xFFFFFFFF;
        }

        add %round, 1;
    }

    label_finalize_mixer:
    {
        xor %state, %key;
        nop;
    }
}

i8 ExtractByte(i64 %value, i32 %byteIndex)
{
    create i64 %temp;
    create i32 %shiftAmount;
    create i8 %result;

    mov %temp, %value;
    mov %shiftAmount, %byteIndex;
    mul %shiftAmount, 8;

    shr %temp, %shiftAmount;
    and %temp, 0xFF;
    mov %result, %temp;

