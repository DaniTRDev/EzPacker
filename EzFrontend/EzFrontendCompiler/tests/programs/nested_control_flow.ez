# Nested control flow stress test
# Exercises: deeply nested if/else, while inside if, if inside while,
# nested while with break/continue, multiple condition operators

void NestedControlFlow(i32 %n, i32 %m, i32 %limit, i64 %threshold)
{
    create i32 %i;
    create i32 %j;
    create i32 %k;
    create i64 %acc;
    create i64 %temp;
    create i32 %flag;

    mov %i, 0;
    mov %acc, 0;
    mov %flag, 0;

    # ── Level 1: outer while ──────────────────────────────────────────────
    while (%i LT %n)
    {
        mov %j, 0;

        # ── Level 2: middle while ────────────────────────────────────────
        while (%j LT %m)
        {
            mov %k, 0;

            # ── Level 3: inner while ─────────────────────────────────────
            while (%k LT %limit)
            {
                # Deeply nested condition chain
                if (%k LT 5)
                {
                    add %acc, 1;
                    if (%acc GT %threshold)
                    {
                        # Break from innermost loop
                        break;
                    }
                }
                else if (%k EQ 5)
                {
                    xor %acc, 0xAA;
                }
                else if (%k LT 10)
                {
                    sub %acc, 1;
                    if (%acc EQ 0)
                    {
                        mov %acc, 1;
                    }
                }
                else
                {
                    # Continue to next iteration
                    add %k, 1;
                    continue;
                }

                add %k, 1;
            }

            # Post-inner-loop condition
            if (%acc GT 100)
            {
                mov %temp, %acc;
                shr %temp, 2;
                and %temp, 0xFF;
                add %acc, %temp;
            }
            else if (%acc EQ 0)
            {
                mov %acc, %j;
                add %acc, 1;
            }

            add %j, 1;
        }

        # Between middle and outer
        if (%i EQ 0)
        {
            mov %flag, 1;
        }
        else if (%i GT 5)
        {
            if (%flag EQ 1)
            {
                xor %acc, %threshold;
                mov %flag, 0;
            }
            else
            {
                add %acc, %i;
            }
        }

        # While inside if
        if (%acc GT 50)
        {
            create i32 %reduceCount;
            mov %reduceCount, 0;
            while (%reduceCount LT 10)
            {
                sub %acc, 1;
                add %reduceCount, 1;
                if (%acc LE 50)
                {
                    break;
                }
            }
        }

        add %i, 1;
    }

    # ── All comparison operators ──────────────────────────────────────────
    if (%acc LT %threshold) { add %acc, 10; }
    if (%acc GT %threshold) { sub %acc, 10; }
    if (%acc EQ %threshold) { xor %acc, 0xFF; }
    if (%acc NE %threshold) { and %acc, 0xFFFF; }
    if (%acc LE %threshold) { or %acc, 1; }
    if (%acc GE %threshold) { shl %acc, 1; }

    # ── Deeply nested while with mixed break/continue ─────────────────────
    mov %i, 0;
    while (%i LT 100)
    {
        if (%i EQ 50)
        {
            break;
        }

        mov %j, 0;
        while (%j LT 20)
        {
            if (%j EQ 10)
            {
                add %j, 1;
                continue;
            }

            if (%j GT 15)
            {
                break;
            }

            add %acc, %j;
            add %j, 1;
        }

        add %i, 1;
    }

    # ── Final nested labels ───────────────────────────────────────────────
    label_postprocess:
    {
        and %acc, 0xFFFFFFFF;

        label_inner_post:
        {
            xor %acc, 0xBEEF;
            nop;
        }
    }

    label_done:
    {
        nop;
    }
}

