# Multiple modules in a single file
# Tests: multiple top-level declarations in one source

void FirstModule()
{
    create i32 %x;
    mov %x, 1;
    nop;
}

void SecondModule()
{
    create i32 %y;
    mov %y, 2;
    nop;
}

i64 ThirdModule(i32 %param)
{
    create i64 %z;
    mov %z, 0;
    add %z, 1;
    nop;
}

