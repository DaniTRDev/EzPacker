# Memory-intensive stress test
# Exercises: many memory operands with different types and offsets, pointer arithmetic,
# load/store patterns, memory inside control flow

void MemoryIntensive(i64 %srcPtr, i64 %dstPtr, i32 %length, i64 %stride)
{
    # ── Variable declarations ──────────────────────────────────────────────
    create i64 %curSrc;
    create i64 %curDst;
    create i32 %counter;
    create i64 %val64;
    create i32 %val32;
    create i16 %val16;
    create i8  %val8;
    create i64 %temp;
    create i64 %accum;
    create i32 %innerIdx;
    create i64 %offsetCalc;
    create i64 %checksum;

    # ── Initialization ─────────────────────────────────────────────────────
    mov %curSrc, %srcPtr;
    mov %curDst, %dstPtr;
    mov %counter, 0;
    mov %val64, 0;
    mov %val32, 0;
    mov %val16, 0;
    mov %val8, 0;
    mov %accum, 0;
    mov %checksum, 0;

    # ── Sequential multi-type memory access ────────────────────────────────
    label_sequential_access:
    {
        # Load various types at different offsets
        mov %val64, i64 (%srcPtr+0);
        mov %val64, i64 (%srcPtr+0x8);
        mov %val64, i64 (%srcPtr+0x10);
        mov %val64, i64 (%srcPtr+0x18);
        mov %val64, i64 (%srcPtr+0x20);
        mov %val64, i64 (%srcPtr+0x28);
        mov %val64, i64 (%srcPtr+0x30);
        mov %val64, i64 (%srcPtr+0x38);

        mov %val32, i32 (%srcPtr+0x40);
        mov %val32, i32 (%srcPtr+0x44);
        mov %val32, i32 (%srcPtr+0x48);
        mov %val32, i32 (%srcPtr+0x4C);

        mov %val16, i16 (%srcPtr+0x50);
        mov %val16, i16 (%srcPtr+0x52);
        mov %val16, i16 (%srcPtr+0x54);
        mov %val16, i16 (%srcPtr+0x56);

        mov %val8, i8 (%srcPtr+0x58);
        mov %val8, i8 (%srcPtr+0x59);
        mov %val8, i8 (%srcPtr+0x5A);
        mov %val8, i8 (%srcPtr+0x5B);

        nop;
    }

    # ── Strided memory access loop ─────────────────────────────────────────
    while (%counter LT %length)
    {
        # Calculate current source offset
        mov %offsetCalc, %curSrc;

        # Load i64 value
        mov %val64, i64 (%offsetCalc+0);
        add %accum, %val64;

        # Load i32 at offset 8
        mov %val32, i32 (%offsetCalc+0x8);
        add %accum, %val32;

        # Load i16 at offset 12
        mov %val16, i16 (%offsetCalc+0xC);
        add %accum, %val16;

        # Load i8 at offset 14
        mov %val8, i8 (%offsetCalc+0xE);
        add %accum, %val8;

        # XOR checksum accumulation
        mov %temp, %val64;
        xor %temp, %val32;
        xor %temp, %val16;
        xor %temp, %val8;
        xor %checksum, %temp;

        # Conditional memory access patterns
        if (%counter LT 10)
        {
            # Access first 10 entries with extra processing
            mov %temp, i64 (%curSrc+0);
            shl %temp, 3;
            xor %checksum, %temp;

            mov %temp, i64 (%curSrc+0x8);
            shr %temp, 2;
            and %checksum, %temp;
        }
        else if (%counter GT 50)
        {
            # Late entries get different treatment
            mov %temp, i64 (%curSrc+0);
            neg %temp;
            add %checksum, %temp;
        }
        else
        {
            # Middle entries
            mov %temp, i64 (%curSrc+0);
            or %checksum, %temp;
        }

        # ── Inner loop: process sub-elements ──────────────────────────────
        mov %innerIdx, 0;
        while (%innerIdx LT 4)
        {
            # Each sub-element is 2 bytes apart starting at offset 0x10
            mov %val16, i16 (%curSrc+0x10);
            add %accum, %val16;

            # Byte-level access
            mov %val8, i8 (%curSrc+0x18);
            xor %accum, %val8;

            add %innerIdx, 1;
        }

        # Advance pointers by stride
        add %curSrc, %stride;
        add %curDst, %stride;
        add %counter, 1;
    }

    # ── Destination pointer writes ─────────────────────────────────────────
    label_write_results:
    {
        # Store computed results back through destination pointer
        mov %temp, %accum;
        and %temp, 0xFFFFFFFF;
        add %temp, %checksum;

        # Multiple destination accesses
        mov %val64, i64 (%dstPtr+0);
        add %val64, %temp;

        mov %val64, i64 (%dstPtr+0x8);
        add %val64, %accum;

        mov %val64, i64 (%dstPtr+0x10);
        xor %val64, %checksum;

        mov %val32, i32 (%dstPtr+0x18);
        add %val32, %counter;

        nop;
    }

    # ── Final checksum validation ──────────────────────────────────────────
    label_validate:
    {
        if (%checksum EQ 0)
        {
            mov %checksum, 0xDEAD;
        }
        else if (%checksum GT 0xFFFFFFFF)
        {
            and %checksum, 0xFFFFFFFF;
        }

        xor %accum, %checksum;
        and %accum, 0xFFFFFFFF;
        nop;
    }
}

