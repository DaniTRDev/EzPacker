# Full pipeline stress test program
# Exercises: modules with many params, all variable types, arithmetic, bitwise,
# memory operands, labels, nested labels, if/else if/else, while, nested while,
# break, continue, hex immediates, comments, and deeply nested scopes.

i64 StressChecksum(i64 %bufferPtr, i32 %length, i64 %key, i64 %salt, i32 %rounds)
{
    # ── Variable declarations ──────────────────────────────────────────────
    create i64 %runningSum;
    create i32 %counter;
    create i64 %currentAddr;
    create i8  %byteVal;
    create i64 %tempCalc;
    create i32 %roundIdx;
    create i64 %roundAccum;
    create i64 %xorMask;
    create i32 %innerCounter;
    create i64 %shiftTemp;
    create i16 %smallTemp;
    create i64 %finalResult;

    # ── Initialization ─────────────────────────────────────────────────────
    mov %runningSum, 0;
    mov %counter, 0;
    mov %currentAddr, %bufferPtr;
    mov %roundIdx, 0;
    mov %roundAccum, 0;
    mov %xorMask, 0xFF00FF00;
    mov %smallTemp, 0;
    mov %finalResult, 0;

    # ── Multi-round processing loop ───────────────────────────────────────
    while (%roundIdx LT %rounds)
    {
        mov %counter, 0;
        mov %currentAddr, %bufferPtr;

        # ── Inner byte-processing loop ────────────────────────────────────
        while (%counter LT %length)
        {
            # Load a byte from memory
            mov %byteVal, i8 (%currentAddr+0);

            # XOR with mask
            xor %byteVal, 0xFF;

            # Promote and add salt
            mov %tempCalc, i64 (%byteVal+0);
            add %tempCalc, %salt;

            # Accumulate with shift
            mov %shiftTemp, %tempCalc;
            shl %shiftTemp, 3;
            xor %tempCalc, %shiftTemp;

            # Add key-based scramble
            add %tempCalc, %key;
            and %tempCalc, %xorMask;

            # Conditional accumulation
            if (%tempCalc GT %key)
            {
                add %runningSum, %tempCalc;
            }
            else if (%tempCalc EQ %key)
            {
                xor %runningSum, %tempCalc;
            }
            else
            {
                sub %runningSum, %tempCalc;
                neg %runningSum;
            }

            # Advance pointer and counter
            add %currentAddr, 1;
            add %counter, 1;
        }

        # ── Post-round mixing ─────────────────────────────────────────────
        mov %innerCounter, 0;
        while (%innerCounter LT %length)
        {
            add %roundAccum, %runningSum;
            shr %roundAccum, 1;
            xor %roundAccum, %key;

            if (%innerCounter EQ 0)
            {
                add %roundAccum, %salt;
            }

            # Nested while with break
            create i32 %breakTest;
            mov %breakTest, 0;
            while (%breakTest LT 10)
            {
                if (%breakTest EQ 5)
                {
                    break;
                }
                add %breakTest, 1;
            }

            add %innerCounter, 1;
        }

        add %roundIdx, 1;
    }

    # ── Labeled finalization stages ────────────────────────────────────────
    label_mix:
    {
        xor %runningSum, %roundAccum;
        and %runningSum, 0xFFFFFFFF;
        add %runningSum, %salt;

        label_inner_mix:
        {
            shl %runningSum, 4;
            shr %runningSum, 2;
            xor %runningSum, 0xDEADBEEF;
            nop;
        }

        or %runningSum, 0x1;
    }

    label_final_check:
    {
        if (%runningSum EQ 0)
        {
            mov %runningSum, 1;
        }
        else if (%runningSum GT 0xFFFF)
        {
            and %runningSum, 0xFFFF;
        }

        mov %finalResult, %runningSum;
        nop;
    }
}

