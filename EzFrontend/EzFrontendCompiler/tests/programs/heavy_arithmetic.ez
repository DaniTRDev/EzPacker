# Heavy arithmetic stress test
# Exercises: long chains of add, sub, mul, div, neg, bitwise ops, hex immediates,
# variable reuse, interleaved operations across many variables

i64 HeavyArithmetic(i64 %a, i64 %b, i64 %c, i32 %iterations)
{
    # ── Many variables of different types ──────────────────────────────────
    create i64 %sum;
    create i64 %diff;
    create i64 %prod;
    create i64 %quot;
    create i64 %accum;
    create i64 %temp1;
    create i64 %temp2;
    create i64 %temp3;
    create i32 %idx;
    create i32 %smallA;
    create i32 %smallB;
    create i16 %word1;
    create i16 %word2;
    create i8  %byte1;
    create i8  %byte2;

    # ── Initialization ─────────────────────────────────────────────────────
    mov %sum, 0;
    mov %diff, 0;
    mov %prod, 1;
    mov %quot, 0;
    mov %accum, 0;
    mov %temp1, 0;
    mov %temp2, 0;
    mov %temp3, 0;
    mov %idx, 0;
    mov %smallA, 0;
    mov %smallB, 0;
    mov %word1, 0;
    mov %word2, 0;
    mov %byte1, 0;
    mov %byte2, 0;

    # ── Chain of arithmetic operations ─────────────────────────────────────
    mov %sum, %a;
    add %sum, %b;
    add %sum, %c;
    sub %sum, 1;
    add %sum, 0xFF;
    sub %sum, 0x10;
    add %sum, 0xDEAD;
    sub %sum, 0xBEEF;

    mov %diff, %a;
    sub %diff, %b;
    sub %diff, %c;
    add %diff, 100;
    sub %diff, 50;
    add %diff, 25;
    sub %diff, 12;
    add %diff, 6;

    mov %prod, %a;
    mul %prod, 2;
    mul %prod, 3;
    mul %prod, 5;
    mul %prod, 7;
    div %prod, 2;
    div %prod, 3;
    mul %prod, 11;
    div %prod, 7;

    mov %quot, %b;
    div %quot, 2;
    div %quot, 2;
    div %quot, 2;
    mul %quot, 8;
    div %quot, 4;
    mul %quot, 16;
    div %quot, 8;

    # ── Negation chains ────────────────────────────────────────────────────
    mov %temp1, %a;
    neg %temp1;
    neg %temp1;
    neg %temp1;
    neg %temp1;
    add %temp1, 1;
    neg %temp1;
    sub %temp1, 1;
    neg %temp1;

    # ── Bitwise operation chains ───────────────────────────────────────────
    mov %temp2, %b;
    xor %temp2, 0xFF;
    and %temp2, 0xFFFF;
    or %temp2, 0x100;
    xor %temp2, %c;
    shl %temp2, 4;
    shr %temp2, 2;
    and %temp2, 0xFFFFFFFF;
    or %temp2, 0x80000000;
    xor %temp2, 0xDEADBEEF;

    mov %temp3, %c;
    shl %temp3, 1;
    shl %temp3, 1;
    shl %temp3, 1;
    shr %temp3, 2;
    xor %temp3, %a;
    and %temp3, %b;
    or %temp3, %c;
    shl %temp3, 8;
    shr %temp3, 4;

    # ── Loop with heavy arithmetic per iteration ──────────────────────────
    while (%idx LT %iterations)
    {
        # Accumulate sum/diff/prod/quot
        add %accum, %sum;
        sub %accum, %diff;
        add %accum, %prod;
        sub %accum, %quot;

        # Re-mix temps
        xor %temp1, %accum;
        and %temp2, %accum;
        or %temp3, %accum;

        # Shift and combine
        shl %accum, 1;
        add %accum, %temp1;
        shr %accum, 1;
        add %accum, %temp2;
        xor %accum, %temp3;

        # Small type operations
        mov %smallA, %idx;
        add %smallA, 1;
        mul %smallA, 3;
        mov %smallB, %smallA;
        sub %smallB, %idx;

        mov %word1, %smallA;
        add %word1, 0x10;
        mov %word2, %smallB;
        sub %word2, 0x5;

        mov %byte1, %word1;
        xor %byte1, 0xAA;
        mov %byte2, %word2;
        and %byte2, 0x0F;

        # Conditional arithmetic
        if (%accum GT 0xFFFF)
        {
            and %accum, 0xFFFF;
            add %accum, %temp1;
        }
        else if (%accum EQ 0)
        {
            mov %accum, 1;
            mul %accum, 0xFF;
        }
        else
        {
            add %accum, %idx;
            xor %accum, 0xAA;
        }

        # Interleaved operations on multiple variables
        add %sum, %byte1;
        sub %diff, %byte2;
        add %prod, %word1;
        sub %quot, %word2;
        add %sum, %smallA;
        sub %diff, %smallB;

        # More arithmetic
        add %temp1, %sum;
        sub %temp1, %diff;
        xor %temp2, %prod;
        and %temp2, %quot;
        or %temp3, %temp1;
        xor %temp3, %temp2;

        add %idx, 1;
    }

    # ── Final mixing ──────────────────────────────────────────────────────
    add %accum, %sum;
    add %accum, %diff;
    add %accum, %prod;
    add %accum, %quot;
    xor %accum, %temp1;
    xor %accum, %temp2;
    xor %accum, %temp3;
    and %accum, 0xFFFFFFFF;

    label_done:
    {
        nop;
    }
}

