# Variable lowering test program
# Tests: create of all types, multiple variables, reuse

void VariableLowering(i32 %input)
{
    create i8  %byte;
    create i16 %word;
    create i32 %dword;
    create i64 %qword;

    mov %byte, 1;
    mov %word, 256;
    mov %dword, %input;
    mov %qword, 0xDEAD;

    add %byte, 1;
    add %word, 2;
    add %dword, 3;
    add %qword, 4;

    sub %dword, %byte;
    add %qword, %dword;

    label_scoped:
    {
        create i32 %scopedVar;
        mov %scopedVar, 99;
        add %scopedVar, %dword;
    }

    nop;
}

