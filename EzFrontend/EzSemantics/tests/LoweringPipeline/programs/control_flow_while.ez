# While loop control flow test program
# Tests: simple while, nested while, while inside if

void ControlFlowWhile(i32 %n, i32 %m)
{
    create i32 %i;
    create i32 %j;
    create i32 %sum;

    mov %i, 0;
    mov %sum, 0;

    while (%i LT %n)
    {
        add %sum, %i;
        add %i, 1;
    }

    mov %i, 0;
    mov %j, 0;

    while (%i LT %n)
    {
        mov %j, 0;
        while (%j LT %m)
        {
            add %sum, 1;
            add %j, 1;
        }
        add %i, 1;
    }

    if (%sum GT %n)
    {
        mov %i, 0;
        while (%i LT %m)
        {
            sub %sum, 1;
            add %i, 1;
        }
    }

    nop;
}

