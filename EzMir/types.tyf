// ============================================================================
// Core Built-in Primitives & Special Types
// ============================================================================

// Special & Control Types
void _void();
bindingToken __bindToken();
pointer ptr();

// Scalar Integers
integer i1(1);
integer i8(8);
integer i16(16);
integer i32(32);
integer i64(64);
integer i128(128);
integer i256(256);

// IEEE 754 Floating-Point Types
float f32(32);
float f64(64);
float f128(128);

// Vector Types (128-bit SSE)
vector v4f32(128, 128);
vector v2f64(128, 128);
vector v16i8(128, 128);
vector v8i16(128, 128);
vector v4i32(128, 128);
vector v2i64(128, 128);

// Vector Types (256-bit AVX)
vector v8f32(256, 256);
vector v4f64(256, 256);
vector v32i8(256, 256);
vector v16i16(256, 256);
vector v8i32(256, 256);
vector v4i64(256, 256);